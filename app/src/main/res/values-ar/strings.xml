    <!-- Settings -->
    <string name="settings_formats_title">صيغ الصوت المدعومة</string>
    <string name="settings_formats_desc">Zeno Play يشغّل كل صيغ الصوت الموجودة على جهازك — وليس MP3 فقط. الصيغ النادرة (APE وDSD وWavPack وMPC وtracker وWMA…) تُشغَّل بمحرك VLC المدمج. صيغة TAK وحدها غير مدعومة.</string>
    <string name="settings_notification_title">إشعار التشغيل</string>
    <string name="settings_notification_desc">أثناء التشغيل، يعرض الإشعار العنوان والفنان والغلاف وأزرار السابق/التشغيل/التالي/الإغلاق، مع موضع الأغنية في القائمة (n/N).</string>
    <string name="settings_about_title">حول</string>
    <string name="settings_about_desc">Zeno Play — مشغل موسيقى. مكتبة محلية، تشغيل في الخلفية مع إشعار، موجات صوتية مباشرة، تضخيم الصوت حتى 200% ودعم كل صيغ الصوت. مجاني للأبد، بلا إعلانات.</string>
    <string name="settings_update_title">التحديثات</string>
    <string name="settings_update_desc">Zeno Play يحدّث نفسه مباشرة من GitHub، بلا إلغاء تثبيت.</string>
    <string name="settings_lyrics_title">كلمات متزامنة</string>
    <string name="settings_eq_title">الإيكولايزر والصوت</string>
    <string name="settings_eq_desc">إيكولايزر بخمسة نطاقات وإعدادات مسبقة وتضخيم الجهير، مع إعدادات لكل مخرج (مكبر الصوت، سماعات الأذن، بلوتوث).</string>
    <string name="settings_tags_title">تعديل الوسوم</string>
    <string name="settings_tags_desc">عدّل العنوان والفنان والألبوم والنوع والسنة والغلاف لعدة أغانٍ دفعة واحدة.</string>
    <string name="settings_backup_title">النسخ الاحتياطي والتصدير</string>
    <string name="settings_backup_desc">احفظ قوائم التشغيل والمفضلة والإعدادات في ملف، وصدّر قوائم التشغيل بصيغة M3U.</string>
    <string name="settings_battery_title">تشغيل بلا انقطاع</string>
