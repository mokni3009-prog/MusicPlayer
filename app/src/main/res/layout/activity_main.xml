<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@drawable/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp">

        <!-- Brand header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="58dp"
                android:layout_height="58dp"
                app:cardCornerRadius="17dp"
                app:cardElevation="0dp"
                app:strokeColor="#FFD76A"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/zeno_logo" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/brandName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textDirection="ltr"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/zeno_ink2"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/app_tag"
                android:textColor="@color/zeno_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/moreButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/about_app"
                android:src="@drawable/ic_more"
                android:tint="@color/zeno_ink2" />

            <ImageButton
                android:id="@+id/updateButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/check_update"
                android:src="@drawable/ic_update"
                android:tint="@color/zeno_cyan" />

        </LinearLayout>

        <!-- Search bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                android:tint="@color/zeno_cyan" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="10dp"
                android:textColor="@color/zeno_ink"
                android:textColorHint="@color/zeno_ink3"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Category chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chipsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chipAll"
                    style="?attr/materialButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_chip_selected"
                    android:text="@string/cat_all"
                    android:textColor="@color/zeno_on_gradient"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/chipTunsi"
                    style="?attr/materialButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip"
                    android:text="@string/cat_tunsi"
                    android:textColor="@color/zeno_ink2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/chipSharqi"
                    style="?attr/materialButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip"
                    android:text="@string/cat_sharqi"
                    android:textColor="@color/zeno_ink2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/chipAjnabi"
                    style="?attr/materialButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip"
                    android:text="@string/cat_ajnabi"
                    android:textColor="@color/zeno_ink2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/chipFav"
                    style="?attr/materialButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip"
                    android:text="@string/cat_fav"
                    android:textColor="@color/zeno_ink2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/chipMine"
                    style="?attr/materialButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip"
                    android:text="@string/cat_mine"
                    android:textColor="@color/zeno_ink2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Library + playlists + now-playing card -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mainRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="96dp" />

    </LinearLayout>

    <!-- Mini player -->
    <LinearLayout
        android:id="@+id/miniPlayerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_mini_player"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/miniProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:max="1000"
            android:progressDrawable="@drawable/seek_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/miniOpen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:cardCornerRadius="11dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/zeno_logo" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/miniTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/zeno_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/miniArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/zeno_ink2"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <ImageButton
                android:id="@+id/miniPrev"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_previous"
                android:tint="@color/zeno_ink2" />

            <ImageButton
                android:id="@+id/miniPlayPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_play_btn"
                android:contentDescription="@string/play"
                android:padding="11dp"
                android:src="@drawable/ic_play"
                android:tint="@color/zeno_on_gradient" />

            <ImageButton
                android:id="@+id/miniNext"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_next"
                android:tint="@color/zeno_ink2" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
