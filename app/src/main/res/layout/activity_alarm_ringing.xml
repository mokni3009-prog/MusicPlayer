<?xml version="1.0" encoding="utf-8"?>
<!-- v1.0.13: ringing screen — shown over the lock screen by the alarm
     notification's full-screen intent, with one big Stop button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="72dp"
    android:paddingEnd="24dp"
    android:paddingBottom="48dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_alarm"
        android:tint="@color/zeno_gold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/alarm_ringing"
        android:textColor="@color/zeno_ink2"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ringAlarmName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/zeno_ink"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ringSongTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/zeno_gold"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ringTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/zeno_ink2"
        android:textSize="20sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/ringStopBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_play_btn"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="@string/alarm_stop"
        android:textColor="@color/zeno_on_gradient"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
