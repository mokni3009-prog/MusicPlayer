    <!-- Settings -->
    <string name="settings_formats_title">Formats audio pris en charge</string>
    <string name="settings_formats_desc">Zeno Play lit tous les formats audio présents sur votre appareil — pas seulement le MP3. Les formats rares (APE, DSD, WavPack, MPC, tracker, WMA…) sont lus avec le moteur VLC intégré. Seul le format TAK n’est pas pris en charge.</string>
    <string name="settings_notification_title">Notification de lecture</string>
    <string name="settings_notification_desc">Pendant la lecture, la notification affiche le titre, l’artiste, la pochette et les boutons Précédent / Lecture / Suivant / Fermer, avec la position dans la file (n/N).</string>
    <string name="settings_about_title">À propos</string>
    <string name="settings_about_desc">Zeno Play — Lecteur de musique. Bibliothèque locale, lecture en arrière-plan avec notification, visualiseur audio en direct, amplification du volume jusqu’à 200 % et prise en charge de tous les formats audio.</string>
    <string name="settings_update_title">Mises à jour</string>
    <string name="settings_update_desc">Zeno Play se met à jour directement depuis GitHub, sans désinstallation.</string>
    <string name="settings_lyrics_title">Paroles synchronisées</string>
    <string name="settings_eq_title">Égaliseur et son</string>
    <string name="settings_eq_desc">Égaliseur 5 bandes, préréglages et amplification des basses, avec des réglages par sortie (haut-parleur, écouteurs, Bluetooth).</string>
    <string name="settings_tags_title">Modifier les tags</string>
    <string name="settings_tags_desc">Modifiez le titre, l’artiste, l’album, le genre, l’année et la pochette de plusieurs chansons à la fois.</string>
    <string name="settings_backup_title">Sauvegarde et export</string>
    <string name="settings_backup_desc">Sauvegardez vos playlists, favoris et réglages dans un fichier, et exportez vos playlists en M3U.</string>
    <string name="settings_battery_title">Lecture sans interruption</string>
    <string name="settings_auto_title">Android Auto</string>
    <string name="settings_auto_desc">Branchez votre téléphone à la voiture : votre bibliothèque apparaît sur l’écran du véhicule.</string>
