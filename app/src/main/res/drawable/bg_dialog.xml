<?xml version="1.0" encoding="utf-8"?>
<!-- Zeno dialog background: dark navy, rounded corners, thin gold edge —
     used by every AlertDialog / popup in the app via Theme.ZenoPlay. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#12264F" />
    <stroke
        android:width="1dp"
        android:color="#3D5A80" />
    <corners android:radius="20dp" />
</shape>
