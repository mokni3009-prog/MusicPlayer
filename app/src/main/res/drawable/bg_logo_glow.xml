<?xml version="1.0" encoding="utf-8"?>
<!-- Neon glow behind the splash logo: gold core fading to cyan, then transparent.
     Radial gradient (no angle attribute, so the 45° gradient guard does not apply). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="110dp"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#CCFFD76A"
        android:centerColor="#662DE2E6"
        android:endColor="#002DE2E6" />
    <corners android:radius="90dp" />
</shape>
