<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient underline for the active tab (gold -> cyan). Angle 0 is valid. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="2dp" />
    <gradient
        android:angle="0"
        android:startColor="#FFD76A"
        android:endColor="#2DE2E6"
        android:type="linear" />
</shape>
