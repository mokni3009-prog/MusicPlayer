<?xml version="1.0" encoding="utf-8"?>
<!-- BOOST badge background: gold-to-cyan gradient (angle 0 — must stay a
     multiple of 45, see the CI gradient guard). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="#2DE2E6"
        android:startColor="#FFD76A"
        android:type="linear" />
    <corners android:radius="12dp" />
</shape>
