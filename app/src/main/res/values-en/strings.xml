    <!-- Settings -->
    <string name="settings_formats_title">Supported audio formats</string>
    <string name="settings_formats_desc">Zeno Play plays every audio format on your device — not just MP3. Rare formats (APE, DSD, WavPack, MPC, tracker, WMA…) play with the built-in VLC engine. Only TAK is not supported.</string>
    <string name="settings_notification_title">Playback notification</string>
    <string name="settings_notification_desc">While playing, the notification shows the title, artist, cover and Previous / Play / Next / Close buttons, with the position in the queue (n/N).</string>
    <string name="settings_about_title">About</string>
    <string name="settings_about_desc">Zeno Play — Music player. Local library, background playback with notification, live audio visualizer, volume boost up to 200% and support for all audio formats.</string>
    <string name="settings_update_title">Updates</string>
    <string name="settings_update_desc">Zeno Play updates itself directly from GitHub, without uninstalling.</string>
    <string name="settings_lyrics_title">Synced lyrics</string>
    <string name="settings_eq_title">Equalizer and sound</string>
