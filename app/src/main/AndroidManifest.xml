<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- v1.0.9: writing tags back into audio files on Android 9 and below
         needs WRITE_EXTERNAL_STORAGE (without it File.canWrite() is false
         and every tag edit fails). Only applies up to API 28; Android 10+
         uses a MediaStore write request instead (see TagEditActivity). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android TV: leanback is optional (same APK also runs on phones/tablets),
         touchscreen is optional (TV has no touchscreen). -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".ZenoPlayApp"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ZenoPlay"
        android:supportsRtl="true">

        <!-- Splash / loading screen: the launcher activity. Shows the logo
             with "Gratuit pour toujours · Sans publicité", then opens the
             main screen (or the TV screen on Android TV). -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.TvMainActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.PlaylistDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.EqActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.SettingsActivity" />

        <activity
            android:name=".ui.TagEditActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.StatsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.RingtoneActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.PlayerActivity" />

        <!-- Luxury: listening summary (Wrapped). -->
        <activity
            android:name=".ui.WrappedActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Luxury: music alarm. -->
        <activity
            android:name=".ui.AlarmActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Luxury: full lock screen (shown over the lock screen). -->
        <activity
            android:name=".ui.LockActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- TEMPORARY self-test screen (see SelfTest.kt) — deletable. -->
        <activity
            android:name=".ui.SelfTestActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.MainActivity" />

        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <receiver
            android:name=".player.VlcActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.musicplayer.app.VLC_PREV" />
                <action android:name="com.musicplayer.app.VLC_TOGGLE" />
                <action android:name="com.musicplayer.app.VLC_NEXT" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget: play/pause/next without opening the app. -->
        <receiver
            android:name=".widget.ZenoWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/zeno_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- Music alarm. -->
        <receiver
            android:name=".ui.AlarmReceiver"
            android:exported="false" />

        <!-- Android Auto: declares this app as a media app for cars. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

    </application>

</manifest>
